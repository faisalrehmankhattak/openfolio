# Copy to .env and add your provider keys, then docker compose up --build.
# GET /healthz returns 503 until configured providers pass their startup checks.

# Speech-to-text: deepgram (cloud) or whisper (local, `uv sync --extra whisper`)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# The brain: any OpenAI-compatible API. Use your provider's fast, cheap model.
#   OpenAI:   LLM_BASE_URL empty, LLM_MODEL=<a current mini/nano model>
#   Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama:   LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY empty
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# OpenAI gpt-5.x / gpt-6 models need reasoning off to use tools here; "auto" handles it.
# Values: auto (default), off, none, low, medium, high
LLM_REASONING_EFFORT=auto

# Voice: kokoro (free, local CPU) or elevenlabs (premium, your cloned voice)
TTS_PROVIDER=kokoro
KOKORO_VOICE=am_michael
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# WebRTC: STUN works on most networks; add a TURN server for strict ones.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Calls allowed at once on this server
MAX_SESSIONS=4
# New calls allowed per visitor IP per 10 minutes (local testing is exempt)
CALLS_PER_IP=6
# Set to 1 when running behind a reverse proxy, so limits use the visitor's real IP
TRUST_PROXY=0

# Docker persists inbox/logs and model cache in named volumes.
# First Kokoro start downloads model weights; allow several minutes.
# Recommended cloud voice (avoids a local TTS model download): TTS_PROVIDER=elevenlabs

# Additional exact browser origins (comma-separated), e.g. your hosted demo URL.
# Also add portfolio embed origins to the persona's allowed_origins.
# DEV_ORIGINS=https://agent.example.com,https://www.example.com

# Optional coturn TURN REST configuration for browser relay credentials.
# Only short-lived credentials are returned to browsers; the secret stays server-side.
# Configure the same secret on your external TURN server using --use-auth-secret.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=
# ICE_SERVERS above configures the worker's own STUN/TURN access independently.
# Do not point containers at localhost to reach an LLM running on your host.
# On Docker Desktop use http://host.docker.internal:11434/v1 and a dummy LLM_API_KEY.
