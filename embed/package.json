{
  "name": "@openfolio/embed",
  "version": "0.2.0",
  "description": "One-line embed for Openfolio, the open-source AI portfolio builder: a 3D AI version of you that talks to recruiters by voice or chat.",
  "scripts": {
    "build": "vite build -c vite.app.config.ts && vite build -c vite.loader.config.ts",
    "dev": "vite build -c vite.app.config.ts --watch",
    "typecheck": "tsc",
    "lint": "biome check src *.ts",
    "format": "biome check --write src *.ts",
    "test": "node --test src/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@met4citizen/headaudio": "^0.1.0",
    "@met4citizen/talkinghead": "^1.7.0",
    "@pipecat-ai/client-js": "^1.14.0",
    "@pipecat-ai/small-webrtc-transport": "^1.11.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "ai-portfolio",
    "ai-portfolio-builder",
    "portfolio-builder",
    "personal-portfolio",
    "portfolio-website",
    "ai-twin",
    "digital-twin",
    "ai-avatar",
    "3d-avatar",
    "talking-head",
    "voice-assistant",
    "chatbot",
    "web-component",
    "webrtc",
    "pipecat",
    "lip-sync",
    "three.js"
  ],
  "homepage": "https://github.com/faisalrehmankhattak/openfolio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faisalrehmankhattak/openfolio.git",
    "directory": "embed"
  }
}
